# LLM API Configuration
# 优化器 LLM API 配置（用于生成和改进提示词）
OPTIMIZER_LLM_API_KEY=your_api_key_here
OPTIMIZER_LLM_MODEL=gpt-4o
OPTIMIZER_LLM_BASE_URL=https://api.openai.com/v1
OPTIMIZER_LLM_TEMPERATURE=1.0
OPTIMIZER_LLM_MAX_TOKENS=2048

# 任务模型 API 配置（用于执行实际任务）
TASK_MODEL_API_KEY=your_api_key_here
TASK_MODEL_NAME=gpt-3.5-turbo
TASK_MODEL_BASE_URL=https://api.openai.com/v1
TASK_MODEL_TEMPERATURE=0.0
TASK_MODEL_MAX_TOKENS=2048

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Optimization Parameters
DEFAULT_ROUNDS=5
DEFAULT_N_PROMPTS=10
DEFAULT_N_ITERS=3

# Search Parameters
BAYESIAN_N_SELECT=10
BAYESIAN_XI=0.01
MAB_N_CLUSTERS=8
MAB_N_ROUNDS=10

# Ensemble Parameters
ENSEMBLE_TOP_K=5
ENSEMBLE_W_MIN=0.05
ENSEMBLE_N_STEPS=200

# Logging
LOG_LEVEL=INFO
LOG_FILE=apo.log
